# Salin file ini jadi .env, lalu sesuaikan dengan container Postgres Alpine
# yang sudah berjalan di komputer Anda (ganti USER, PASSWORD, PORT, DB_NAME).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smart_poultry

JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=1440

DEVICE_HEARTBEAT_INTERVAL_SECONDS=10
