# Copy this file to .env and fill in the values.
#
# DATABASE_URL — choose the variant that matches how you run the app:
#
# Option A (recommended): App runs on HOST machine, DB runs via docker-compose.
#   docker compose up -d starts the `db` container and maps port 5432 → localhost.
DATABASE_URL=postgresql+psycopg://admin:popuri123@localhost:5432/smart_poultry
#
# Option B: Both app and DB run inside docker-compose (e.g. a future `backend` service).
#   Replace `localhost` with the compose service name so Docker's internal DNS resolves it.
# DATABASE_URL=postgresql+psycopg://admin:popuri123@db:5432/smart_poultry

JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=1440

DEVICE_HEARTBEAT_INTERVAL_SECONDS=10
