# Salin file ini menjadi `.env` (cp .env.example .env), lalu sesuaikan. File `.env` JANGAN di-commit.
# Panduan lengkap: docs/panduan/setup-backend.md

# --- Database -----------------------------------------------------------------------------
# Aplikasi berjalan di komputer Anda (bukan di dalam Docker), database di Docker (docker-compose.yml).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/NAMA_DB
#   - HOST     : localhost (JANGAN memakai IP WSL 172.x; IP itu berubah setiap WSL dinyalakan)
#   - PORT     : sama dengan POSTGRES_PORT saat `docker compose up` (default 5432)
DATABASE_URL=postgresql+psycopg://admin:popuri123@localhost:5432/smart_poultry

# Opsional: database untuk `pytest`. Jika kosong, dipakai nama database di atas + akhiran `_test`
# (smart_poultry_test) pada server yang sama dan dibuat otomatis. Nama WAJIB berakhiran `_test`
# karena test menghapus seluruh isi database tersebut.
# TEST_DATABASE_URL=postgresql+psycopg://admin:popuri123@localhost:5432/smart_poultry_test

# --- Keamanan -----------------------------------------------------------------------------
# Rahasia penanda JWT. Buat string acak panjang, mis.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=1440

# --- Alat / perintah ----------------------------------------------------------------------
DEVICE_HEARTBEAT_INTERVAL_SECONDS=10
# Perintah PENDING/DIAMBIL yang tidak diproses alat -> TIMEOUT setelah (detik)
PERINTAH_TIMEOUT_PENDING_SECONDS=60
# Perintah BERJALAN yang tidak melapor -> TIMEOUT setelah (detik)
PERINTAH_TIMEOUT_BERJALAN_SECONDS=300
# Alat dianggap OFFLINE bila tidak heartbeat lebih dari (detik); 0 = 3x heartbeat
ALAT_OFFLINE_AFTER_SECONDS=0

# --- Lain-lain ----------------------------------------------------------------------------
# true untuk mencetak setiap SQL ke terminal (debugging)
SQL_ECHO=false
# Origin frontend yang diizinkan (CORS), format JSON array
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
